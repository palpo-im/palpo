+// registrationDummyRetry completes only a server-advertised dummy-only flow.
+// Token/email/password stages must still fail rather than being bypassed.
+func registrationDummyRetry(instr instruction, response []byte) (instruction, bool) {
+	if instr.method != http.MethodPost || instr.path != "/_matrix/client/v3/register" || instr.accessToken != "" {
+		return instruction{}, false
+	}
+	var challenge struct {
+		Session string `json:"session"`
+		Flows   []struct {
+			Stages []string `json:"stages"`
+		} `json:"flows"`
+	}
+	if json.Unmarshal(response, &challenge) != nil || challenge.Session == "" {
+		return instruction{}, false
+	}
+	dummyOnly := false
+	for _, flow := range challenge.Flows {
+		if len(flow.Stages) == 1 && flow.Stages[0] == "m.login.dummy" {
+			dummyOnly = true
+		}
+	}
+	body, ok := instr.body.(map[string]interface{})
+	if !dummyOnly || !ok {
+		return instruction{}, false
+	}
+	auth, ok := body["auth"].(map[string]string)
+	if !ok || auth["type"] != "m.login.dummy" || auth["session"] != "" {
+		return instruction{}, false
+	}
+	// Do not mutate the original instruction's map, which may be reused.
+	retryBody := make(map[string]interface{}, len(body))
+	for key, value := range body {
+		retryBody[key] = value
+	}
+	retryBody["auth"] = map[string]string{"type": "m.login.dummy", "session": challenge.Session}
+	instr.body = retryBody
+	return instr, true
+}
