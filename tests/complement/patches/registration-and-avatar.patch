@@ -0,0 +1,85 @@
+package instruction
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/matrix-org/complement/b"
+)
+
+func TestRegistrationDummySession(t *testing.T) {
+	for _, tc := range []struct {
+		name        string
+		challenge   string
+		acceptRetry bool
+		wantCalls   int
+		wantSuccess bool
+	}{
+		{"direct success", "", true, 1, true},
+		{"session", `{"session":"issued-session","flows":[{"stages":["m.login.dummy"]}]}`, true, 2, true},
+		{"retry rejected", `{"session":"issued-session","flows":[{"stages":["m.login.dummy"]}]}`, false, 2, false},
+		{"missing session", `{"flows":[{"stages":["m.login.dummy"]}]}`, false, 1, false},
+		{"token required", `{"session":"issued-session","flows":[{"stages":["m.login.registration_token","m.login.dummy"]}]}`, false, 1, false},
+		{"email required", `{"session":"issued-session","flows":[{"stages":["m.login.email.identity"]}]}`, false, 1, false},
+		{"malformed", `{`, false, 1, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			calls := 0
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+				calls++
+				var body map[string]interface{}
+				if err := json.NewDecoder(req.Body).Decode(&body); err != nil {
+					t.Error(err)
+				}
+				if req.Method != http.MethodPost || req.URL.Path != "/_matrix/client/v3/register" || body["username"] != "alice" {
+					t.Errorf("incorrect registration request: %s %s %+v", req.Method, req.URL.Path, body)
+				}
+				if calls == 2 {
+					auth, _ := body["auth"].(map[string]interface{})
+					if auth["session"] != "issued-session" || auth["type"] != "m.login.dummy" || body["password"] != "complement_meets_min_pasword_req_alice" {
+						t.Errorf("retry lost credentials/session: %+v", body)
+					}
+					if tc.acceptRetry {
+						w.Write([]byte(`{"access_token":"token","device_id":"device"}`))
+						return
+					}
+				}
+				if tc.challenge == "" {
+					w.Write([]byte(`{"access_token":"token","device_id":"device"}`))
+					return
+				}
+				w.WriteHeader(http.StatusUnauthorized)
+				w.Write([]byte(tc.challenge))
+			}))
+			defer srv.Close()
+			runner := NewRunner("uiaa", false, false)
+			instr := instructionRegister(b.Homeserver{Name: "hs1"}, b.User{Localpart: "alice"})
+			err := runner.runInstructionSet("test", srv.URL, []instruction{instr})
+			if (err == nil) != tc.wantSuccess || calls != tc.wantCalls {
+				t.Fatalf("got err=%v calls=%d; want success=%v calls=%d", err, calls, tc.wantSuccess, tc.wantCalls)
+			}
+			if tc.wantSuccess && runner.AccessTokens("hs1")["@alice:hs1"] != "token" {
+				t.Fatal("retry response was not stored")
+			}
+			if _, exists := instr.body.(map[string]interface{})["auth"].(map[string]string)["session"]; exists {
+				t.Fatal("mutated original instruction")
+			}
+		})
+	}
+}
+
+func TestRegistrationRetryDoesNotHandleOtherEndpoints(t *testing.T) {
+	challenge := []byte(`{"session":"s","flows":[{"stages":["m.login.dummy"]}]}`)
+	for _, instr := range []instruction{
+		{method: http.MethodGet, path: "/_matrix/client/v3/register"},
+		{method: http.MethodPost, path: "/_matrix/client/v3/login"},
+		{method: http.MethodPost, path: "/_matrix/client/v3/register", accessToken: "as-token"},
+	} {
+		instr.body = map[string]interface{}{"username": "alice", "auth": map[string]string{"type": "m.login.dummy"}}
+		if _, ok := registrationDummyRetry(instr, challenge); ok {
+			t.Fatalf("retried non-blueprint registration: %+v", instr)
+		}
+	}
+}
